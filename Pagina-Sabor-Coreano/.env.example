# Copia este archivo como ".env" y ajusta los valores si es necesario.

# URL del backend Laravel (sin barra final). En producción, apuntar al dominio real de la API.
NEXT_PUBLIC_API_URL=http://localhost/api

# Prisma soporta el formato de connection string nativo de PostgreSQL.
# Ver documentación: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sabor_coreano"
